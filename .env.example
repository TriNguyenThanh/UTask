# Shared template: copy to .env on each machine before running Docker Compose.
# These values are for local development only. Replace every password and secret
# before using any shared environment.

UTASK_HTTP_PORT=8080
# Local image namespace/tag. The staging workflow supplies the release SHA.
# For manual staging commands, replace these with the published namespace/SHA.
UTASK_IMAGE_PREFIX=utask
UTASK_IMAGE_TAG=local
# Values below are the environment-specific inputs consumed by the env_file
# mappings in infra/env/. This file (or an ignored environment-specific copy)
# is the only place where their values are supplied.
POSTGRES_USER=utask
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

IDENTITY_DB_NAME=identity_db
IDENTITY_DJANGO_SECRET_KEY=change-me-identity-django-secret
# Generate a local RSA private key at this path before starting Identity.
# Keep the PEM untracked; production supplies a dedicated managed signing key.
IDENTITY_JWT_PRIVATE_KEY_HOST_PATH=./.local-secrets/identity-jwt-private.pem
# Base64 of 32 random bytes for encrypted activation/reset events. Supply the
# same key and key ID to Notification; empty values keep these flows unavailable.
IDENTITY_MAIL_KEY=
IDENTITY_MAIL_KEY_ID=
# Local leaves Redis cache unset; staging Compose defaults to its Redis service.
IDENTITY_REDIS_URL=
IDENTITY_SERVICE_KEYS={}
IDENTITY_FRONTEND_URL=https://localhost

# Optional features: supply credentials/callbacks before enabling each flag.
IDENTITY_GOOGLE_ENABLED=false
IDENTITY_GOOGLE_CLIENT_ID=
IDENTITY_GOOGLE_CLIENT_SECRET=
IDENTITY_GOOGLE_CALLBACK_URI=
IDENTITY_GITHUB_ENABLED=false
IDENTITY_GITHUB_CLIENT_ID=
IDENTITY_GITHUB_CALLBACK_URI=
# Staging Compose defaults to http://integration-service:8000.
IDENTITY_INTEGRATION_URL=
IDENTITY_INTEGRATION_KEY=
IDENTITY_AVATAR_ENABLED=false
IDENTITY_R2_ENDPOINT=
IDENTITY_R2_BUCKET=
IDENTITY_R2_ACCESS_KEY=
IDENTITY_R2_SECRET_KEY=
IDENTITY_R2_PUBLIC_URL=

WORK_DB_NAME=work_db
WORK_DJANGO_SECRET_KEY=change-me-work-django-secret

CLASSROOM_DB_NAME=classroom_db
CLASSROOM_DJANGO_SECRET_KEY=change-me-classroom-django-secret

INTEGRATION_DB_NAME=integration_db
INTEGRATION_DJANGO_SECRET_KEY=change-me-integration-django-secret

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DJANGO_SECRET_KEY=change-me-notification-django-secret

DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nginx,identity-service,work-service,classroom-service,integration-service,notification-service

# Stable local KRaft cluster identifier. Generate a different value for an
# isolated environment instead of reusing a production identifier.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
