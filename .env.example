# Mẫu cấu hình theo nhóm và thứ tự biến trong .env local.
# Copy thành .env trên từng máy; điền secret riêng trước khi chạy service tương ứng.
# Mật khẩu, token và khóa thật không được đưa vào file mẫu này.

# Docker Compose
UTASK_HTTP_PORT=8080
UTASK_IMAGE_PREFIX=utask
UTASK_IMAGE_TAG=local

# PostgreSQL dùng chung; mỗi service khai báo database ở nhóm riêng.
POSTGRES_USER=utask
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Cấu hình Django dùng chung và hostname local/ngrok.
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nginx,identity-service,work-service,classroom-service,integration-service,notification-service,tigerishly-farinose-shaunda.ngrok-free.dev

# Identity Service: tài khoản, JWT, khóa gọi nội bộ và lưu trữ file.
IDENTITY_DB_NAME=identity_db
IDENTITY_DJANGO_SECRET_KEY=change-me-identity-django-secret
IDENTITY_MAIL_KEY=
IDENTITY_MAIL_KEY_ID=identity-local-key-1
IDENTITY_JWT_PRIVATE_KEY_HOST_PATH=./.local-secrets/identity-jwt-private.pem
# Các entry work/classroom/ai phải khớp key caller tương ứng; ai dùng AI_IDENTITY_SERVICE_KEY.
IDENTITY_SERVICE_KEYS='{"work":"change-me-work-service-key","classroom":"change-me-classroom-service-key","ai":"change-me-ai-identity-service-key","notification":"change-me-notification-identity-key"}'
IDENTITY_WORK_SERVICE_KEY=change-me-work-service-key
IDENTITY_BASE_URL=http://identity-service:8000
IDENTITY_JWT_ISSUER=https://identity.utask.internal
IDENTITY_JWT_AUDIENCE=utask-platform
IDENTITY_R2_ENDPOINT=https://6ce8192fe248f702d086d2ec572ba8fc.r2.cloudflarestorage.com
IDENTITY_R2_ACCESS_KEY=
IDENTITY_R2_SECRET_KEY=
IDENTITY_R2_BUCKET=utask
IDENTITY_R2_PUBLIC_URL=https://utask-r2.u-code.dev

# Classroom Service: lớp học, quyền truy cập và kết nối Work.
CLASSROOM_DB_NAME=classroom_db
CLASSROOM_DJANGO_SECRET_KEY=change-me-classroom-django-secret
CLASSROOM_WORK_SERVICE_KEY=change-me-classroom-work-service-key
CLASSROOM_ACCESS_CODE_HMAC_KEY=change-me-classroom-access-code-hmac-key
CLASSROOM_BASE_URL=http://classroom-service:8000
CLASSROOM_REDIS_URL=redis://redis:6379/3
IDENTITY_CLASSROOM_SERVICE_KEY=change-me-classroom-service-key

# Work Service: dự án, adapter Classroom, Redis và lưu trữ file.
WORK_DB_NAME=work_db
WORK_DJANGO_SECRET_KEY=change-me-work-django-secret
WORK_CLASSROOM_ADAPTER=infrastructure.classroom.RemoteClassroom
WORK_CLASSROOM_DEV_ENABLED=false
WORK_REDIS_URL=redis://redis:6379/2
WORK_R2_ENDPOINT=https://6ce8192fe248f702d086d2ec572ba8fc.r2.cloudflarestorage.com
WORK_R2_ACCESS_KEY=
WORK_R2_SECRET_KEY=
WORK_R2_BUCKET=utask

# Kafka: broker, topic và consumer group. Bỏ profile kafka nếu dùng broker bên ngoài.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
WORK_KAFKA_TOPIC=utask.work.events
CLASSROOM_KAFKA_TOPIC=utask.classroom.events
CLASSROOM_WORK_KAFKA_GROUP=classroom-work-projects-v1
CLASSROOM_WORK_KAFKA_DLQ_TOPIC=utask.classroom.work.dlq
CLASSROOM_CONSUMER_MAX_RETRIES=5
WORK_CLASSROOM_KAFKA_GROUP=work-classroom-groups-v1
WORK_CLASSROOM_KAFKA_DLQ_TOPIC=utask.work.classroom.dlq
WORK_CLASSROOM_CONSUMER_MAX_RETRIES=5
KAFKA_LOG_RETENTION_MS=604800000
COMPOSE_PROFILES=kafka
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=

# Integration Service: GitHub App, consent, credential và webhook.
INTEGRATION_DB_NAME=integration_db
INTEGRATION_DJANGO_SECRET_KEY=change-me-integration-django-secret
# Mẫu dùng role riêng cho Integration; không dùng role quản trị PostgreSQL.
INTEGRATION_DB_USER=integration_service
INTEGRATION_DB_PASSWORD=change-me-integration-db-password
# Điền secret riêng và App ID/Client ID từ GitHub App settings.
INTEGRATION_GITHUB_WEBHOOK_SECRET=
INTEGRATION_GITHUB_APP_ID=
INTEGRATION_GITHUB_APP_SLUG=utask-integration-dev
INTEGRATION_GITHUB_CLIENT_ID=
INTEGRATION_GITHUB_CLIENT_SECRET=
# Chỉ bật khi đã điền đủ credential, callback và khóa mã hóa.
INTEGRATION_GITHUB_APP_ENABLED=false
INTEGRATION_GITHUB_REDIRECT_URI=https://tigerishly-farinose-shaunda.ngrok-free.dev/api/integrations/healthz
INTEGRATION_GITHUB_SETUP_URI=https://tigerishly-farinose-shaunda.ngrok-free.dev/api/integrations/healthz
INTEGRATION_CONSENT_COOKIE_SECURE=true
# Consent key là Fernet; credential key ring là JSON array dùng khóa Fernet khác.
INTEGRATION_CONSENT_KEY=
INTEGRATION_CREDENTIAL_KEYS='[]'
# Bật lần lượt sau migration/cấu hình và smoke; mặc định tắt.
INTEGRATION_CONNECTIONS_ENABLED=false
INTEGRATION_KAFKA_ENABLED=false
INTEGRATION_AI_CONTEXT_ENABLED=false
# Key gọi vào Integration: JSON mapping Work/AI; key gọi sang Work tách riêng.
INTEGRATION_SERVICE_KEYS='{}'
INTEGRATION_WORK_SERVICE_KEY=
INTEGRATION_WORK_URL=http://work-service:8000
# Để trống để dùng KAFKA_* chung; topic cố định utask.integration.events.
INTEGRATION_KAFKA_BOOTSTRAP_SERVERS=
INTEGRATION_KAFKA_SECURITY_PROTOCOL=
INTEGRATION_KAFKA_SASL_MECHANISM=
INTEGRATION_KAFKA_SASL_USERNAME=
INTEGRATION_KAFKA_SASL_PASSWORD=
INTEGRATION_KAFKA_SSL_CA_LOCATION=
INTEGRATION_KAFKA_SSL_CERTIFICATE_LOCATION=
INTEGRATION_KAFKA_SSL_KEY_LOCATION=
INTEGRATION_KAFKA_SSL_KEY_PASSWORD=

# Notification Service
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DJANGO_SECRET_KEY=change-me-notification-django-secret
NOTIFICATION_DB_USER=notification_service
NOTIFICATION_DB_PASSWORD=change-me-notification-db-password
NOTIFICATION_SERVICE_TOKEN=change-me-notification-internal-token
IDENTITY_NOTIFICATION_SERVICE_KEY=change-me-notification-identity-key
NOTIFICATION_IDENTITY_ENABLED=false
NOTIFICATION_WORK_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_REDIS_URL=redis://redis:6379/5
NOTIFICATION_FRONTEND_URL=https://localhost
# JSON mapping key_id -> base64 AES-256 key, matching Identity encryption key.
NOTIFICATION_MAIL_KEYS='{}'
NOTIFICATION_SMTP_HOST=smtp.gmail.com
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=utask-notification-service
NOTIFICATION_SMTP_PASSWORD=wwsf zwle pfpv bqjq
NOTIFICATION_FROM_EMAIL=6451071079@st.utc2.edu.vn
NOTIFICATION_EMAILS_PER_DAY=100
NOTIFICATION_IDENTITY_KAFKA_GROUP=notification-identity-v1
NOTIFICATION_WORK_KAFKA_GROUP=notification-work-v1

# AI Service: runtime local, domain endpoint và cấu hình model.
DATASETS_DIR=/app/datasets
WORK_SERVICE_URL=http://work-service:8000
INTEGRATION_SERVICE_URL=http://integration-service:8000
AI_DB_NAME=ai_context_db
AI_DB_PASSWORD=change-me-ai-postgres
AI_ENVIRONMENT=development
MOCK_TEST=true
AI_HTTP_PORT=8000
AI_DATABASE_URL=
AI_BROKER_URL=
AI_COMPLETION_RECONCILE_SECONDS=5
AI_REQUESTS_PER_MINUTE=5
AI_MAX_ACTIVE_REQUESTS_PER_USER=2
AI_GITHUB_CONTEXT_ENABLED=false
AI_TERMINAL_RETENTION_DAYS=30
AI_RETENTION_BATCH_SIZE=500
AI_RETENTION_INTERVAL_SECONDS=3600
AI_JWT_ISSUER=https://identity.utask.internal
AI_JWT_AUDIENCE=utask-platform
AI_JWT_ALGORITHM=RS256
AI_AUTHORIZATION_URLS='{}'
AI_CONTEXT_URLS='{}'
AI_LLM_PROVIDER=litellm
AI_MODEL=gemini-3.8-flash-high
AI_LLM_API_BASE=http://host.docker.internal:8317/v1
# AI lấy JWKS từ AI_IDENTITY_BASE_URL + /.well-known/jwks.json như Work.
# Fernet key phải giống nhau cho API/worker/dispatcher/beat.
AI_CREDENTIAL_KEY=
AI_IDENTITY_BASE_URL=http://identity-service:8000
# Khớp entry ai trong IDENTITY_SERVICE_KEYS; điền secret thật trên server.
AI_IDENTITY_SERVICE_KEY=
AI_LLM_API_KEY=
# Tạm thời không gửi service key AI→Work; vẫn gửi bearer và kiểm tra quyền domain.
AI_WORK_SERVICE_AUTH_ENABLED=false
AI_WORK_SERVICE_KEY=
AI_INTEGRATION_SERVICE_KEY=
AI_WORKER_CONCURRENCY=2
# Chỉ cần nếu chủ động chạy live evaluation thủ công; không bắt buộc để deploy staging.
EVAL_AI_BASE_URL=http://nginx
EVAL_AI_BEARER=
EVAL_AI_PROJECT_ID=
EVAL_AI_TASK_ID=
EVAL_AI_SPRINT_ID=
EVAL_EXPECTED_MODEL=
EVAL_AI_CASE_TARGETS='{}'
EVAL_AI_CASE_EXPECTATIONS='{}'

# Biến tùy chọn; để mặc định nếu môi trường không sử dụng.
IDENTITY_REDIS_URL=
IDENTITY_FRONTEND_URL=https://localhost
IDENTITY_GOOGLE_ENABLED=false
IDENTITY_GOOGLE_CLIENT_ID=
IDENTITY_GOOGLE_CLIENT_SECRET=
IDENTITY_GOOGLE_CALLBACK_URI=
IDENTITY_GITHUB_ENABLED=false
IDENTITY_GITHUB_CLIENT_ID=
IDENTITY_GITHUB_CALLBACK_URI=
IDENTITY_INTEGRATION_URL=
IDENTITY_INTEGRATION_KEY=
IDENTITY_AVATAR_ENABLED=false
WORK_IDENTITY_KAFKA_TOPIC=
WORK_STORAGE_ADAPTER=
WORK_AI_ADAPTER=
# Map caller ai/integration -> [key hiện tại, key trước khi xoay]; không dùng chung key.
WORK_SERVICE_KEYS='{}'
WORK_INTEGRATION_ADAPTER=
WORK_GITHUB_CONNECTION_ENABLED=false
WORK_INTEGRATION_BASE_URL=http://integration-service:8000
WORK_INTEGRATION_SERVICE_KEY=
WORK_INTEGRATION_INBOUND_KEYS='[]'
WORK_INTEGRATION_KAFKA_GROUP=work-integration-connections-v1
WORK_INTEGRATION_DLQ_TOPIC=utask.work.integration.dlq
INTEGRATION_IDENTITY_URL=http://identity-service:8000
INTEGRATION_REDIS_URL=redis://redis:6379/4
