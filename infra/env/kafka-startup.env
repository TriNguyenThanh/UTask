# Local startup topics; reuse the producer/consumer mappings without credentials.
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS:-kafka:9092}
WORK_KAFKA_TOPIC=${WORK_KAFKA_TOPIC:-utask.work.events}
WORK_IDENTITY_KAFKA_TOPIC=${WORK_IDENTITY_KAFKA_TOPIC:-${IDENTITY_KAFKA_TOPIC:-utask.identity.events}}
CLASSROOM_KAFKA_TOPIC=${CLASSROOM_KAFKA_TOPIC:-utask.classroom.events}
CLASSROOM_WORK_KAFKA_DLQ_TOPIC=${CLASSROOM_WORK_KAFKA_DLQ_TOPIC:-utask.classroom.work.dlq}
WORK_CLASSROOM_KAFKA_DLQ_TOPIC=${WORK_CLASSROOM_KAFKA_DLQ_TOPIC:-utask.work.classroom.dlq}
WORK_INTEGRATION_DLQ_TOPIC=${WORK_INTEGRATION_DLQ_TOPIC:-utask.work.integration.dlq}
