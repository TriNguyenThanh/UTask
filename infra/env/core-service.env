# Unified environment mapping for UTask Core Modular Monolith (Identity, Classroom, Work).
DATABASE_NAME=${CORE_DB_NAME:?Set CORE_DB_NAME in .env}
DJANGO_SECRET_KEY=${CORE_DJANGO_SECRET_KEY:?Set CORE_DJANGO_SECRET_KEY in .env}
CORE_REDIS_URL=${CORE_REDIS_URL:-redis://redis:6379/0}

# Identity JWT, mail encryption, session & retention policy
IDENTITY_JWT_PRIVATE_KEY_PATH=/run/identity-secrets/jwt-private.pem
IDENTITY_JWT_ISSUER=${IDENTITY_JWT_ISSUER:-https://identity.utask.internal}
IDENTITY_JWT_AUDIENCE=${IDENTITY_JWT_AUDIENCE:-utask-platform}
IDENTITY_MAIL_KEY=${IDENTITY_MAIL_KEY:-}
IDENTITY_MAIL_KEY_ID=${IDENTITY_MAIL_KEY_ID:-}
IDENTITY_SERVICE_KEYS=${IDENTITY_SERVICE_KEYS:-{}}
IDENTITY_FRONTEND_URL=${IDENTITY_FRONTEND_URL:-https://localhost}
IDENTITY_CSRF_TRUSTED_ORIGINS=${IDENTITY_CSRF_TRUSTED_ORIGINS:-}
IDENTITY_ACCESS_TOKEN_SECONDS=${IDENTITY_ACCESS_TOKEN_SECONDS:-9000}
IDENTITY_REFRESH_TOKEN_SECONDS=${IDENTITY_REFRESH_TOKEN_SECONDS:-604800}
IDENTITY_SESSION_RETENTION_DAYS=${IDENTITY_SESSION_RETENTION_DAYS:-30}
IDENTITY_RECEIPT_RETENTION_DAYS=${IDENTITY_RECEIPT_RETENTION_DAYS:-7}
IDENTITY_OUTBOX_RETENTION_DAYS=${IDENTITY_OUTBOX_RETENTION_DAYS:-7}
# Built-in Docker bridge default; no root .env entry is required.
IDENTITY_TRUSTED_PROXY_CIDRS=${IDENTITY_TRUSTED_PROXY_CIDRS:-172.16.0.0/12}
IDENTITY_REQUIRE_EMAIL_ACTIVATION=${IDENTITY_REQUIRE_EMAIL_ACTIVATION:-false}

# Identity OAuth (Google / GitHub)
IDENTITY_GOOGLE_ENABLED=${IDENTITY_GOOGLE_ENABLED:-false}
IDENTITY_GOOGLE_CLIENT_ID=${IDENTITY_GOOGLE_CLIENT_ID:-}
IDENTITY_GOOGLE_CLIENT_SECRET=${IDENTITY_GOOGLE_CLIENT_SECRET:-}
IDENTITY_GOOGLE_CALLBACK_URI=${IDENTITY_GOOGLE_CALLBACK_URI:-}
IDENTITY_GITHUB_ENABLED=${IDENTITY_GITHUB_ENABLED:-false}
IDENTITY_GITHUB_CLIENT_ID=${IDENTITY_GITHUB_CLIENT_ID:-}
IDENTITY_GITHUB_CALLBACK_URI=${IDENTITY_GITHUB_CALLBACK_URI:-}
IDENTITY_INTEGRATION_URL=${IDENTITY_INTEGRATION_URL:-http://integration-service:8000}
IDENTITY_INTEGRATION_KEY=${IDENTITY_INTEGRATION_KEY:-}

# Classroom HMAC access codes
CLASSROOM_ACCESS_CODE_HMAC_KEY=${CLASSROOM_ACCESS_CODE_HMAC_KEY:-}

# Unified Cloudflare R2 Storage (avatars & attachments; falls back to legacy WORK_R2_*/IDENTITY_R2_*)
IDENTITY_AVATAR_ENABLED=${IDENTITY_AVATAR_ENABLED:-false}
CORE_STORAGE_ADAPTER=${CORE_STORAGE_ADAPTER:-${WORK_STORAGE_ADAPTER:-infrastructure.storage.R2Storage}}
CORE_R2_ENDPOINT=${CORE_R2_ENDPOINT:-${WORK_R2_ENDPOINT:-${IDENTITY_R2_ENDPOINT:-}}}
CORE_R2_ACCESS_KEY=${CORE_R2_ACCESS_KEY:-${WORK_R2_ACCESS_KEY:-${IDENTITY_R2_ACCESS_KEY:-}}}
CORE_R2_SECRET_KEY=${CORE_R2_SECRET_KEY:-${WORK_R2_SECRET_KEY:-${IDENTITY_R2_SECRET_KEY:-}}}
CORE_R2_BUCKET=${CORE_R2_BUCKET:-${WORK_R2_BUCKET:-${IDENTITY_R2_BUCKET:-}}}
CORE_R2_PUBLIC_URL=${CORE_R2_PUBLIC_URL:-${IDENTITY_R2_PUBLIC_URL:-}}

# Kafka (external contracts for Notification and Integration)
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS:-kafka:9092}
KAFKA_SECURITY_PROTOCOL=${KAFKA_SECURITY_PROTOCOL:-PLAINTEXT}
KAFKA_SASL_MECHANISM=${KAFKA_SASL_MECHANISM:-PLAIN}
KAFKA_SASL_USERNAME=${KAFKA_SASL_USERNAME:-}
KAFKA_SASL_PASSWORD=${KAFKA_SASL_PASSWORD:-}
KAFKA_SSL_CA_LOCATION=${KAFKA_SSL_CA_LOCATION:-}
IDENTITY_KAFKA_TOPIC=${IDENTITY_KAFKA_TOPIC:-utask.identity.events}
WORK_KAFKA_TOPIC=${WORK_KAFKA_TOPIC:-utask.work.events}
WORK_INTEGRATION_KAFKA_GROUP=${WORK_INTEGRATION_KAFKA_GROUP:-work-integration-connections-v1}
WORK_INTEGRATION_DLQ_TOPIC=${WORK_INTEGRATION_DLQ_TOPIC:-utask.work.integration.dlq}

# External service-to-service adapters (AI, Integration, Notification)
WORK_AI_ADAPTER=${WORK_AI_ADAPTER:-infrastructure.ai.UnavailableProposals}
WORK_AI_BASE_URL=${WORK_AI_BASE_URL:-http://ai-service:8000}
WORK_AI_SERVICE_KEY=${WORK_AI_SERVICE_KEY:-}
WORK_SERVICE_KEYS=${WORK_SERVICE_KEYS:-{}}
WORK_INTEGRATION_ADAPTER=${WORK_INTEGRATION_ADAPTER:-infrastructure.integration.UnavailableIntegration}
WORK_GITHUB_CONNECTION_ENABLED=${WORK_GITHUB_CONNECTION_ENABLED:-false}
WORK_GITHUB_ACTIVITY_CACHE_TTL_SECONDS=${WORK_GITHUB_ACTIVITY_CACHE_TTL_SECONDS:-45}
WORK_INTEGRATION_BASE_URL=${WORK_INTEGRATION_BASE_URL:-http://integration-service:8000}
WORK_INTEGRATION_SERVICE_KEY=${WORK_INTEGRATION_SERVICE_KEY:-}
WORK_INTEGRATION_INBOUND_KEYS=${WORK_INTEGRATION_INBOUND_KEYS:-[]}
NOTIFICATION_SERVICE_TOKEN=${NOTIFICATION_SERVICE_TOKEN:-}
IDENTITY_NOTIFICATION_SERVICE_KEY=${IDENTITY_NOTIFICATION_SERVICE_KEY:-}
