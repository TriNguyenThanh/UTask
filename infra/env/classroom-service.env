DATABASE_NAME=${CLASSROOM_DB_NAME:?Set CLASSROOM_DB_NAME in .env}
DJANGO_SECRET_KEY=${CLASSROOM_DJANGO_SECRET_KEY:?Set CLASSROOM_DJANGO_SECRET_KEY in .env}
IDENTITY_BASE_URL=${IDENTITY_BASE_URL:-http://identity-service:8000}
IDENTITY_CLASSROOM_SERVICE_KEY=${IDENTITY_CLASSROOM_SERVICE_KEY:-}
IDENTITY_JWT_ISSUER=${IDENTITY_JWT_ISSUER:-https://identity.utask.internal}
IDENTITY_JWT_AUDIENCE=${IDENTITY_JWT_AUDIENCE:-utask-platform}
CLASSROOM_WORK_SERVICE_KEY=${CLASSROOM_WORK_SERVICE_KEY:-}
CLASSROOM_ACCESS_CODE_HMAC_KEY=${CLASSROOM_ACCESS_CODE_HMAC_KEY:-}
CLASSROOM_REDIS_URL=${CLASSROOM_REDIS_URL:-redis://redis:6379/3}
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS:-kafka:9092}
KAFKA_SECURITY_PROTOCOL=${KAFKA_SECURITY_PROTOCOL:-PLAINTEXT}
KAFKA_SASL_MECHANISM=${KAFKA_SASL_MECHANISM:-PLAIN}
KAFKA_SASL_USERNAME=${KAFKA_SASL_USERNAME:-}
KAFKA_SASL_PASSWORD=${KAFKA_SASL_PASSWORD:-}
KAFKA_SSL_CA_LOCATION=${KAFKA_SSL_CA_LOCATION:-}
CLASSROOM_KAFKA_TOPIC=${CLASSROOM_KAFKA_TOPIC:-utask.classroom.events}
CLASSROOM_WORK_KAFKA_TOPIC=${WORK_KAFKA_TOPIC:-utask.work.events}
CLASSROOM_WORK_KAFKA_GROUP=${CLASSROOM_WORK_KAFKA_GROUP:-classroom-work-projects-v1}
CLASSROOM_WORK_KAFKA_DLQ_TOPIC=${CLASSROOM_WORK_KAFKA_DLQ_TOPIC:-utask.classroom.work.dlq}
CLASSROOM_CONSUMER_MAX_RETRIES=${CLASSROOM_CONSUMER_MAX_RETRIES:-5}
