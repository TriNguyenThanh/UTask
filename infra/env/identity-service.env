DATABASE_NAME=${IDENTITY_DB_NAME:?Set IDENTITY_DB_NAME in .env}
DJANGO_SECRET_KEY=${IDENTITY_DJANGO_SECRET_KEY:?Set IDENTITY_DJANGO_SECRET_KEY in .env}

IDENTITY_MAIL_KEY=${IDENTITY_MAIL_KEY:-}
IDENTITY_MAIL_KEY_ID=${IDENTITY_MAIL_KEY_ID:-}
IDENTITY_JWT_PRIVATE_KEY_PATH=/run/identity-secrets/jwt-private.pem

IDENTITY_REDIS_URL=${IDENTITY_REDIS_URL:-}
IDENTITY_SERVICE_KEYS=${IDENTITY_SERVICE_KEYS:-{}}
IDENTITY_FRONTEND_URL=${IDENTITY_FRONTEND_URL:-https://localhost}
IDENTITY_CSRF_TRUSTED_ORIGINS=${IDENTITY_CSRF_TRUSTED_ORIGINS:-}
IDENTITY_ACCESS_TOKEN_SECONDS=${IDENTITY_ACCESS_TOKEN_SECONDS:-9000}
IDENTITY_REFRESH_TOKEN_SECONDS=${IDENTITY_REFRESH_TOKEN_SECONDS:-604800}
IDENTITY_SESSION_RETENTION_DAYS=${IDENTITY_SESSION_RETENTION_DAYS:-30}
IDENTITY_RECEIPT_RETENTION_DAYS=${IDENTITY_RECEIPT_RETENTION_DAYS:-7}
IDENTITY_OUTBOX_RETENTION_DAYS=${IDENTITY_OUTBOX_RETENTION_DAYS:-7}
IDENTITY_KAFKA_TOPIC=${IDENTITY_KAFKA_TOPIC:-utask.identity.events}
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS:-kafka:9092}
KAFKA_SECURITY_PROTOCOL=${KAFKA_SECURITY_PROTOCOL:-PLAINTEXT}
KAFKA_SASL_MECHANISM=${KAFKA_SASL_MECHANISM:-PLAIN}
KAFKA_SASL_USERNAME=${KAFKA_SASL_USERNAME:-}
KAFKA_SASL_PASSWORD=${KAFKA_SASL_PASSWORD:-}
KAFKA_SSL_CA_LOCATION=${KAFKA_SSL_CA_LOCATION:-}
# Built-in Docker bridge default; no root .env entry is required.
IDENTITY_TRUSTED_PROXY_CIDRS=${IDENTITY_TRUSTED_PROXY_CIDRS:-172.16.0.0/12}

IDENTITY_GOOGLE_ENABLED=${IDENTITY_GOOGLE_ENABLED:-false}
IDENTITY_GOOGLE_CLIENT_ID=${IDENTITY_GOOGLE_CLIENT_ID:-}
IDENTITY_GOOGLE_CLIENT_SECRET=${IDENTITY_GOOGLE_CLIENT_SECRET:-}
IDENTITY_GOOGLE_CALLBACK_URI=${IDENTITY_GOOGLE_CALLBACK_URI:-}

IDENTITY_GITHUB_ENABLED=${IDENTITY_GITHUB_ENABLED:-false}
IDENTITY_GITHUB_CLIENT_ID=${IDENTITY_GITHUB_CLIENT_ID:-}
IDENTITY_GITHUB_CALLBACK_URI=${IDENTITY_GITHUB_CALLBACK_URI:-}
IDENTITY_INTEGRATION_URL=${IDENTITY_INTEGRATION_URL:-}
IDENTITY_INTEGRATION_KEY=${IDENTITY_INTEGRATION_KEY:-}

IDENTITY_AVATAR_ENABLED=${IDENTITY_AVATAR_ENABLED:-false}
IDENTITY_R2_ENDPOINT=${IDENTITY_R2_ENDPOINT:-}
IDENTITY_R2_BUCKET=${IDENTITY_R2_BUCKET:-}
IDENTITY_R2_ACCESS_KEY=${IDENTITY_R2_ACCESS_KEY:-}
IDENTITY_R2_SECRET_KEY=${IDENTITY_R2_SECRET_KEY:-}
IDENTITY_R2_PUBLIC_URL=${IDENTITY_R2_PUBLIC_URL:-}

NOTIFICATION_SERVICE_TOKEN=${NOTIFICATION_SERVICE_TOKEN:-}
IDENTITY_NOTIFICATION_SERVICE_KEY=${IDENTITY_NOTIFICATION_SERVICE_KEY:-}
