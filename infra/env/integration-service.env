DATABASE_NAME=${INTEGRATION_DB_NAME:?Set INTEGRATION_DB_NAME in .env}
DJANGO_SECRET_KEY=${INTEGRATION_DJANGO_SECRET_KEY:?Set INTEGRATION_DJANGO_SECRET_KEY in .env}
INTEGRATION_DB_USER=${INTEGRATION_DB_USER:?Set INTEGRATION_DB_USER in .env}
INTEGRATION_DB_PASSWORD=${INTEGRATION_DB_PASSWORD:?Set INTEGRATION_DB_PASSWORD in .env}
POSTGRES_HOST=${POSTGRES_HOST:?Set POSTGRES_HOST in .env}
POSTGRES_PORT=${POSTGRES_PORT:?Set POSTGRES_PORT in .env}
