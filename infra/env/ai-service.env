DATASETS_DIR=/app/datasets
WORK_SERVICE_URL=${WORK_SERVICE_URL:-http://work-service:8000}
INTEGRATION_SERVICE_URL=${INTEGRATION_SERVICE_URL:-http://integration-service:8000}

# Cấu hình AI không chứa secret. Secret nằm trong .env ở repository root.
AI_ENVIRONMENT=development
MOCK_TEST=true

AI_HTTP_PORT='8000'

AI_DATABASE_URL=postgresql+psycopg://localhost/ai_context_db
AI_BROKER_URL=redis://localhost:6379/0
AI_COMPLETION_RECONCILE_SECONDS=5
AI_JWT_ISSUER='utask-local-mock'
AI_JWT_AUDIENCE='utask-ai'
AI_JWT_ALGORITHM='RS256'
AI_JWT_JWKS_URL=
AI_AUTHORIZATION_URLS={}
AI_CONTEXT_URLS={}
AI_MODEL='gemini-flash-latest'
