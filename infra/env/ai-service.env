# Runtime values are supplied by the repository-root .env; this file only maps
# them into the AI containers. Compose injects secrets separately from .env.
DATASETS_DIR=${DATASETS_DIR:-/app/datasets}
WORK_SERVICE_URL=${WORK_SERVICE_URL:-http://work-service:8000}
INTEGRATION_SERVICE_URL=${INTEGRATION_SERVICE_URL:-http://integration-service:8000}
AI_ENVIRONMENT=${AI_ENVIRONMENT:-development}
MOCK_TEST=${MOCK_TEST:-true}
AI_HTTP_PORT=${AI_HTTP_PORT:-8000}
AI_DATABASE_URL=${AI_DATABASE_URL:-}
AI_BROKER_URL=${AI_BROKER_URL:-}
AI_COMPLETION_RECONCILE_SECONDS=${AI_COMPLETION_RECONCILE_SECONDS:-5}
AI_REQUESTS_PER_MINUTE=${AI_REQUESTS_PER_MINUTE:-5}
AI_MAX_ACTIVE_REQUESTS_PER_USER=${AI_MAX_ACTIVE_REQUESTS_PER_USER:-2}
AI_GITHUB_CONTEXT_ENABLED=${AI_GITHUB_CONTEXT_ENABLED:-false}
AI_TERMINAL_RETENTION_DAYS=${AI_TERMINAL_RETENTION_DAYS:-30}
AI_RETENTION_BATCH_SIZE=${AI_RETENTION_BATCH_SIZE:-500}
AI_RETENTION_INTERVAL_SECONDS=${AI_RETENTION_INTERVAL_SECONDS:-3600}
AI_JWT_ISSUER=${AI_JWT_ISSUER:-${IDENTITY_JWT_ISSUER:-https://identity.utask.internal}}
AI_JWT_AUDIENCE=${AI_JWT_AUDIENCE:-${IDENTITY_JWT_AUDIENCE:-utask-platform}}
AI_WORK_SERVICE_AUTH_ENABLED=${AI_WORK_SERVICE_AUTH_ENABLED:-false}
AI_JWT_ALGORITHM=${AI_JWT_ALGORITHM:-RS256}
AI_AUTHORIZATION_URLS=${AI_AUTHORIZATION_URLS:-{}}
AI_CONTEXT_URLS=${AI_CONTEXT_URLS:-{}}
AI_LLM_PROVIDER=${AI_LLM_PROVIDER:-litellm}
AI_MODEL=${AI_MODEL:-gemini-3.8-flash-high}
AI_LLM_API_BASE=${AI_LLM_API_BASE:-http://host.docker.internal:8317/v1}
