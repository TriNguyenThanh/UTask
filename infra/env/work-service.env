WORK_CLASSROOM_KAFKA_TOPIC=${CLASSROOM_KAFKA_TOPIC:-utask.classroom.events}
WORK_CLASSROOM_KAFKA_GROUP=${WORK_CLASSROOM_KAFKA_GROUP:-work-classroom-groups-v1}
WORK_CLASSROOM_KAFKA_DLQ_TOPIC=${WORK_CLASSROOM_KAFKA_DLQ_TOPIC:-utask.work.classroom.dlq}
WORK_CLASSROOM_CONSUMER_MAX_RETRIES=${WORK_CLASSROOM_CONSUMER_MAX_RETRIES:-5}
