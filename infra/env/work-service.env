DATABASE_NAME=${WORK_DB_NAME:?Set WORK_DB_NAME in .env}
DJANGO_SECRET_KEY=${WORK_DJANGO_SECRET_KEY:?Set WORK_DJANGO_SECRET_KEY in .env}
IDENTITY_BASE_URL=${IDENTITY_BASE_URL:-http://identity-service:8000}
IDENTITY_WORK_SERVICE_KEY=${IDENTITY_WORK_SERVICE_KEY:-}
WORK_REDIS_URL=${WORK_REDIS_URL:-redis://redis:6379/2}
WORK_IDENTITY_KAFKA_TOPIC=${WORK_IDENTITY_KAFKA_TOPIC:-}
WORK_CLASSROOM_ADAPTER=${WORK_CLASSROOM_ADAPTER:-infrastructure.classroom.UnavailableClassroom}
WORK_CLASSROOM_DEV_ENABLED=${WORK_CLASSROOM_DEV_ENABLED:-false}
WORK_R2_ENDPOINT=${WORK_R2_ENDPOINT:-}
WORK_R2_ACCESS_KEY=${WORK_R2_ACCESS_KEY:-}
WORK_R2_SECRET_KEY=${WORK_R2_SECRET_KEY:-}
WORK_R2_BUCKET=${WORK_R2_BUCKET:-}
WORK_STORAGE_ADAPTER=${WORK_STORAGE_ADAPTER:-infrastructure.storage.R2Storage}
WORK_AI_ADAPTER=${WORK_AI_ADAPTER:-infrastructure.ai.UnavailableProposals}
WORK_INTEGRATION_ADAPTER=${WORK_INTEGRATION_ADAPTER:-infrastructure.integration.UnavailableIntegration}
