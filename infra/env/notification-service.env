DJANGO_SECRET_KEY=${NOTIFICATION_DJANGO_SECRET_KEY:?Set NOTIFICATION_DJANGO_SECRET_KEY in .env}
DATABASE_NAME=${NOTIFICATION_DB_NAME:-notification_db}
NOTIFICATION_SERVICE_TOKEN=${NOTIFICATION_SERVICE_TOKEN:-}
IDENTITY_NOTIFICATION_SERVICE_KEY=${IDENTITY_NOTIFICATION_SERVICE_KEY:-}
IDENTITY_BASE_URL=${IDENTITY_BASE_URL:-http://identity-service:8000}
WORK_BASE_URL=${NOTIFICATION_WORK_BASE_URL:-http://work-service:8000}
IDENTITY_JWT_ISSUER=${IDENTITY_JWT_ISSUER:-https://identity.utask.internal}
IDENTITY_JWT_AUDIENCE=${IDENTITY_JWT_AUDIENCE:-utask-platform}
NOTIFICATION_REDIS_URL=${NOTIFICATION_REDIS_URL:-redis://redis:6379/5}
NOTIFICATION_FRONTEND_URL=${NOTIFICATION_FRONTEND_URL:-https://localhost}
NOTIFICATION_MAIL_KEYS=${NOTIFICATION_MAIL_KEYS:-{}}
NOTIFICATION_IDENTITY_ENABLED=${NOTIFICATION_IDENTITY_ENABLED:-false}
NOTIFICATION_WORK_ENABLED=${NOTIFICATION_WORK_ENABLED:-false}
NOTIFICATION_EMAIL_ENABLED=${NOTIFICATION_EMAIL_ENABLED:-false}
EMAIL_ENABLED=${NOTIFICATION_EMAIL_ENABLED:-false}
SMTP_HOST=${NOTIFICATION_SMTP_HOST:-smtp.gmail.com}
SMTP_PORT=${NOTIFICATION_SMTP_PORT:-587}
SMTP_USERNAME=${NOTIFICATION_SMTP_USERNAME:-}
SMTP_PASSWORD=${NOTIFICATION_SMTP_PASSWORD:-}
SMTP_FROM_EMAIL=${NOTIFICATION_FROM_EMAIL:-}
NOTIFICATION_EMAILS_PER_DAY=${NOTIFICATION_EMAILS_PER_DAY:-100}
KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS:-kafka:9092}
KAFKA_SECURITY_PROTOCOL=${KAFKA_SECURITY_PROTOCOL:-PLAINTEXT}
KAFKA_SASL_MECHANISM=${KAFKA_SASL_MECHANISM:-PLAIN}
KAFKA_SASL_USERNAME=${KAFKA_SASL_USERNAME:-}
KAFKA_SASL_PASSWORD=${KAFKA_SASL_PASSWORD:-}
KAFKA_SSL_CA_LOCATION=${KAFKA_SSL_CA_LOCATION:-}
KAFKA_IDENTITY_TOPIC=${IDENTITY_KAFKA_TOPIC:-utask.identity.events}
KAFKA_WORK_TOPIC=${WORK_KAFKA_TOPIC:-utask.work.events}
NOTIFICATION_IDENTITY_KAFKA_GROUP=${NOTIFICATION_IDENTITY_KAFKA_GROUP:-notification-identity-v1}
NOTIFICATION_WORK_KAFKA_GROUP=${NOTIFICATION_WORK_KAFKA_GROUP:-notification-work-v1}
