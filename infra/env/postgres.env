# Database preparation inputs; Integration uses a dedicated login role.
POSTGRES_DB=${POSTGRES_DB:?Set POSTGRES_DB in .env}
IDENTITY_DB_NAME=${IDENTITY_DB_NAME:?Set IDENTITY_DB_NAME in .env}
WORK_DB_NAME=${WORK_DB_NAME:?Set WORK_DB_NAME in .env}
CLASSROOM_DB_NAME=${CLASSROOM_DB_NAME:?Set CLASSROOM_DB_NAME in .env}
INTEGRATION_DB_NAME=${INTEGRATION_DB_NAME:?Set INTEGRATION_DB_NAME in .env}
NOTIFICATION_DB_NAME=${NOTIFICATION_DB_NAME:?Set NOTIFICATION_DB_NAME in .env}
INTEGRATION_DB_USER=${INTEGRATION_DB_USER:?Set INTEGRATION_DB_USER in .env}
INTEGRATION_DB_PASSWORD=${INTEGRATION_DB_PASSWORD:?Set INTEGRATION_DB_PASSWORD in .env}
