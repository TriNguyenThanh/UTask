# Cấu hình mẫu. Copy thành .env và điền credential ngoài source.
# Password dùng cho compose.yaml local; tránh ký tự cần URL encode.
AI_DB_PASSWORD=
AI_HTTP_PORT=8000
# Cho uv chạy ngoài Compose, trỏ tới PostgreSQL/Redis của AI riêng.
AI_DATABASE_URL=postgresql+psycopg://localhost/ai_context_db
AI_BROKER_URL=redis://localhost:6379/0
# Sinh bằng: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
AI_CREDENTIAL_KEY=
AI_JWT_ISSUER=
AI_JWT_AUDIENCE=
AI_JWT_ALGORITHM=RS256
# Chọn public key PEM hoặc JWKS của Identity đã xác minh.
AI_JWT_PUBLIC_KEY=
# AI_JWT_JWKS_URL=https://identity.example/.well-known/jwks.json
# URL nội bộ đã được service sở hữu công bố; không suy ra endpoint từ ví dụ.
AI_AUTHORIZATION_URLS={}
AI_CONTEXT_URLS={}
AI_MODEL=gemini-flash-latest
GOOGLE_API_KEY=
