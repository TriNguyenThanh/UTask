# Bật MSW mock layer trong dev mode.
VITE_ENABLE_MOCKS=true

# Mock scenario cho dev server và browser. Các giá trị khả dụng:
#   default                        — auth + my-work mixed state
#   slow-network                   — mọi request chậm 1.2s
#   server-error                   — mọi endpoint trả 500
#   my-work-no-courses             — sinh viên không có môn học nào
#   my-work-no-team                — có môn học nhưng chưa có nhóm
#   my-work-pending-membership     — đang chờ duyệt vào nhóm
#   my-work-member                 — sinh viên là Member mọi nhóm
#   my-work-leader                 — sinh viên là Leader mọi nhóm
#   my-work-mixed                  — 1 leader + 1 member + 1 chưa nhóm + 1 pending
#   my-work-empty-tasks            — không có task, sprint vẫn hiển thị
#   my-work-overdue                — có task quá hạn + sprint trễ
#   my-work-github-error           — riêng section GitHub lỗi (retry được)
#   student-no-courses             — Student flow: không có môn học
#   student-no-team                — SE330 ở trạng thái Team Formation (chưa có nhóm)
#   student-join-pending           — SE330 Team Formation, đang chờ duyệt
#   student-team-leader-topic-draft — Leader team NEXUS, đề tài draft
#   student-team-member-topic-pending — Member, đề tài đang chờ duyệt
#   student-topic-revision-required — Đề tài bị yêu cầu chỉnh sửa
#   student-project-member         — chỉ project role member
#   student-project-leader         — chỉ project role leader
#   student-mixed-memberships      — role khác nhau theo từng course/project
#   student-github-disconnected    — GitHub chưa kết nối (code page + settings)
#   student-ai-key-missing         — BYOK key chưa cấu hình (CTA Project Settings)
#   student-empty                  — danh sách rỗng (notifications/projects)
#   student-loading                — mọi request Student flow chậm 1.2s
#   student-partial-error          — notifications + code lỗi 500, phần còn lại OK
#   student-forbidden              — project endpoints trả 403 (Forbidden page)
VITE_MOCK_SCENARIO=default

# Base URL cho API thật; rỗng khi chạy mock.
VITE_API_BASE_URL=