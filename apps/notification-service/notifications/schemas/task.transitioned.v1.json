{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task.transitioned v1",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "task.transitioned"
    },
    "event_version": {
      "const": 1
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "const": "work-service"
    },
    "data": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "state_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "actor_user_id": {
          "type": "string",
          "format": "uuid"
        },
        "recipient_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "project_id",
        "state_id",
        "version",
        "actor_user_id",
        "recipient_ids"
      ],
      "additionalProperties": true
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "entity_version": {
      "type": "integer",
      "minimum": 0
    },
    "project_sequence": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "aggregate_id",
    "occurred_at",
    "trace_id",
    "producer",
    "data",
    "project_id",
    "entity_version",
    "project_sequence"
  ],
  "additionalProperties": false
}
